# ── Secrets: never commit ────────────────────────────────────────────────────
secrets.toml
watchlist.toml
*.key
*.pem
*.macaroon
.env
.env.*
!.env.example
*.credentials

# ── State: contains HMACs of real user targets ───────────────────────────────
state.db
state.db-wal
state.db-shm
*.sqlite
*.sqlite3

# ── Python ───────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
dist/
build/

# ── Local ────────────────────────────────────────────────────────────────────
.DS_Store
*.swp
*.log

# tools/mutate.py crash journal — never committed; it holds a copy of a source file
.mutate-journal.json
